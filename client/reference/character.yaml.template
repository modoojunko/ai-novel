# character.yaml - 角色设定模板
# 每个角色一个yaml文件
# 键名与前端 CharacterManager 表单 / AI 生成（settings_characters.prompt）一致

name: ""
role: ""              # 角色在故事中的身份（主角/配角/反派…），注入 prompt 用
appearance: ""        # 外貌描述
background: ""        # 背景故事
speech: ""            # 说话风格
world_view: ""        # 世界观（角色对世界的看法）
self_image: ""        # 自我认知（角色如何看自己）
values: ""            # 价值观（注入 prompt 用）
abilities: ""         # 能力（注入 prompt 用）
skills: ""            # 习得技能（注入 prompt 用）
environment: ""       # 成长背景 + 当前处境（注入 prompt 用）
possessions: ""       # 随身物品/资源
relationships: ""     # 与其他角色的关系（注入 prompt 用）
experiences: ""       # 经历/事迹
personality: ""       # 性格特征（AI 生成角色时产出；state_history 为空时兜底注入当前状态）

# 状态历史（归档时由 Agent 更新，注入 prompt 用最后一条 status/state）
state_history: []
