# AI Novel — Configuration

# Security: Change these before deploying!
JWT_SECRET=change-me-in-production
ADMIN_TOKEN=change-me-in-production   # S端 管理后台 token

CORS_ORIGINS=*

# AI Provider — Supports Anthropic native or DeepSeek (Anthropic-compatible)
# For Anthropic: set AI_API_KEY only
# For DeepSeek: set AI_API_KEY + AI_BASE_URL
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.deepseek.com/anthropic

# Model mapping (provider-agnostic names → actual model IDs)
# Anthropic: haiku=claude-haiku-4-5-20251001, sonnet=claude-sonnet-4-5-20251001
# DeepSeek:  haiku=deepseek-v4-flash,     sonnet=deepseek-v4-pro
AI_MODEL_HAIKU=deepseek-v4-flash
AI_MODEL_SONNET=deepseek-v4-pro

# Storage backend: local | database
STORAGE_BACKEND=local
DATA_ROOT=./data/projects
ADMIN_EMAILS=admin@your-domain.com